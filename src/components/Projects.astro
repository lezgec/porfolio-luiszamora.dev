---
import AstroIcon from "../../public/icons/AstroIcon.astro";
import GithubIcon from "../../public/icons/GithubIcon.astro";
import AIIcon from "../../public/icons/AIIcon.astro";
import ApisIcon from "../../public/icons/ApisIcon.astro";
import CodeIcon from "../../public/icons/CodeIcon.astro";
import CSharpIcon from "../../public/icons/CSharpIcon.astro";
import CssIcon from "../../public/icons/CssIcon.astro";
import DotNetIcon from "../../public/icons/DotNetIcon.astro";
import GameIcon from "../../public/icons/GameIcon.astro";
import HtmlIcon from "../../public/icons/HtmlIcon.astro";
import JavaScriptIcon from "../../public/icons/JavaScriptIcon.astro";
import LinkedinIcon from "../../public/icons/LinkedinIcon.astro";
import LinkIcon from "../../public/icons/LinkIcon.astro";
import MailIcon from "../../public/icons/MailIcon.astro";
import MySqlIcon from "../../public/icons/MySqlIcon.astro";
import NextjsIcon from "../../public/icons/NextjsIcon.astro";
import PHPIcon from "../../public/icons/PHPIcon.astro";
import ReactIcon from "../../public/icons/ReactIcon.astro";
import SqliteIcon from "../../public/icons/SqLiteIcon.astro";
import TailwindIcon from "../../public/icons/TailwindIcon.astro";
import TypeScriptIcon from "../../public/icons/TypeScriptIcon.astro";
import UserIcon from "../../public/icons/UserIcon.astro";
import VueIcon from "../../public/icons/VueIcon.astro";

const TAGS = {
  VUE: {
    name: "Vue.js",
    class: "bg-green-700 text-white",
    icon: VueIcon,
  },

  HTML: {
    name: "HTML",
    class: "bg-orange-500 text-white",
    icon: HtmlIcon,
  },

  CSS: {
    name: "CSS",
    class: "bg-blue-600 text-white",
    icon: CssIcon,
  },

  JAVASCRIPT: {
    name: "JavaScript",
    class: "bg-yellow-500 text-black",
    icon: JavaScriptIcon,
  },

  TYPESCRIPT: {
    name: "TypeScript",
    class: "bg-blue-600 text-white",
    icon: TypeScriptIcon,
  },

  REACT: {
    name: "React",
    class: "bg-cyan-600 text-white",
    icon: ReactIcon,
  },

  NEXTJS: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextjsIcon,
  },

  ASTRO: {
    name: "Astro",
    class: "bg-purple-700 text-white",
    icon: AstroIcon,
  },

  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-cyan-600 text-white",
    icon: TailwindIcon,
  },

  DOTNET: {
    name: ".NET",
    class: "bg-purple-700 text-white",
    icon: DotNetIcon,
  },

  CSHARP: {
    name: "C#",
    class: "bg-purple-700 text-white",
    icon: CSharpIcon,
  },

  PHP: {
    name: "PHP",
    class: "bg-indigo-600 text-white",
    icon: PHPIcon,
  },

  MYSQL: {
    name: "MySQL",
    class: "bg-blue-700 text-white",
    icon: MySqlIcon,
  },

  SQLITE: {
    name: "SQLite",
    class: "bg-blue-700 text-white",
    icon: SqliteIcon,
  },

  API: {
    name: "APIs",
    class: "bg-emerald-700 text-white",
    icon: ApisIcon,
  },

  AI: {
    name: "AI",
    class: "bg-violet-700 text-white",
    icon: AIIcon,
  },

  GAME: {
    name: "Game",
    class: "bg-red-600 text-white",
    icon: GameIcon,
  },

  CODE: {
    name: "Desarrollo",
    class: "bg-slate-700 text-white",
    icon: CodeIcon,
  },

  GITHUB: {
    name: "GitHub",
    class: "bg-gray-900 text-white",
    icon: GithubIcon,
  },

  LINKEDIN: {
    name: "LinkedIn",
    class: "bg-blue-700 text-white",
    icon: LinkedinIcon,
  },

  LINK: {
    name: "Link",
    class: "bg-gray-700 text-white",
    icon: LinkIcon,
  },

  MAIL: {
    name: "Email",
    class: "bg-red-600 text-white",
    icon: MailIcon,
  },

  USER: {
    name: "Usuario",
    class: "bg-gray-700 text-white",
    icon: UserIcon,
  },
};

const PROJECTS = [
  {title: "Registro de Calificaciones V1.0",
    description:
      "Aplicación de escritorio para registrar y gestionar calificaciones académicas, con almacenamiento local en SQLite. Desarrollada con C# y .NET para facilitar la organización y consulta de notas.",
    link: "https://github.com/lezgec/RegistroCalificaciones/releases/tag/v1.0.0",
    github: "https://github.com/lezgec/RegistroCalificaciones.git",
    image: 'https://raw.githubusercontent.com/lezgec/porfolio-luiszamora.dev/refs/heads/main/public/images/project2.png',
    tags: [TAGS.DOTNET, TAGS.SQLITE, TAGS.CSHARP],}
  ,
  {title: "Calculadora IMC WEB",
    description:
      "Aplicación web que calcula el índice de masa corporal a partir del peso y la altura, y muestra la clasificación del resultado mediante una interfaz sencilla. Desarrollada con HTML, CSS y JavaScript.",
    link: "IMC",
    github: "https://github.com/lezgec/CALCULADOR-IMC.git",
    image: 'https://raw.githubusercontent.com/lezgec/porfolio-luiszamora.dev/refs/heads/main/public/images/project3.png',
    tags: [TAGS.HTML, TAGS.JAVASCRIPT, TAGS.CSS],}
    ,
    {title: "SpamKill",
    description:
      "Gestión de publicidad y suscripciones de Gmail y Outlook, conexión OAuth, clasificación de remitentes, bajas y acciones sobre mensajes.",
    link: "https://spamkill.luiszamora.dev/",
    github: "https://github.com/lezgec/SpamKill.git",
    image: 'https://raw.githubusercontent.com/lezgec/porfolio-luiszamora.dev/refs/heads/main/public/images/project5.png',
    tags: [TAGS.NEXTJS, TAGS.REACT, TAGS.TYPESCRIPT, TAGS.MYSQL, TAGS.API],}
    ,
    {title: "Serious Game: Cholesterol",
    description:
      "Juego educativo con dificultad adaptativa, salas docentes, roles, rankings, insignias, generación de preguntas con Gemini y reportes PDF/CSV.",
    link: "https://juego.luiszamora.dev/colesterol_game/",
    github: "https://github.com/lezgec/colesterol_game.git",
    image: 'https://raw.githubusercontent.com/lezgec/porfolio-luiszamora.dev/refs/heads/main/public/images/project4.png',
    tags: [TAGS.PHP, TAGS.JAVASCRIPT, TAGS.MYSQL, TAGS.GAME, TAGS.AI],}
];
---

{
  PROJECTS.map(({ title, description, image, tags, link, github }) => (
    <article class="flex sm:flex-row flex-col gap-x-4 mb-5">
      <img
        class="sm:max-w-96 rounded-2xl shadow-2xl shadow-white/10 "
        src={image}
        alt={`Captura de pantalla del Proyeto`}
      />
      <span>
        <h3 class="text-3xl font-semibold dark:text-white mt-3 ">{title}</h3>
        <ul class="flex flex-row my-3">
          {tags.map((tag) => (
            <li>
              <span
                class={`flex gap-x-2 mr-2 items-center rounded-full text-sm px-4 py-2 ${tag.class}`}
              >
                <tag.icon class="size-4 lg:size-6" />
                {tag.name}
              </span>
            </li>
          ))}
        </ul>
        <p class="text-lg dark:text-gray-200 text-pretty">{description}</p>
        <span class="flex flex-row gap-x-4 mt-4">
          <a
            href= {link}
            target="_blank"
          rel="noopener"
            class="flex flex-row items-center text-white border border-gray-700 bg-gray-900 hover:bg-gray-700 rounded-lg text-xl px-3 py-2 text-center"
          >
            <LinkIcon class="size-4 lg:size-6 mr-2" />
            Preview
          </a>
          <a
            href={github}
            target="_blank"
            rel="noopener"
            class="flex flex-row items-center text-white border border-gray-700 bg-gray-900 hover:bg-gray-700 rounded-lg text-xl px-3 py-2 text-center"
          >
            <GithubIcon class="size-4 lg:size-6 mr-2" />
            Code
          </a>
        </span>
      </span>
    </article>
  ))
}
